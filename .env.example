# Copia este ficheiro para .env e preenche os valores reais
# O .env NÃO é commitado (ver .gitignore)

# PostHog — https://eu.posthog.com → Project Settings → Project API Key
EXPO_PUBLIC_POSTHOG_API_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Ambiente — definido automaticamente pelo EAS (development/preview/production)
# EXPO_PUBLIC_ENV=development
